"use client";

import dynamic from "next/dynamic";
import { Chart as ChartType } from "../lib/types";

const RechartsComposedChart = dynamic(
  () => import("recharts").then((mod) => mod.PieChart),
  { ssr: false }
);
const Pie = dynamic(() => import("recharts").then((mod) => mod.Pie), { ssr: false });
const Cell = dynamic(() => import("recharts").then((mod) => mod.Cell), { ssr: false });
const Legend = dynamic(() => import("recharts").then((mod) => mod.Legend), { ssr: false });
const Tooltip = dynamic(() => import("recharts").then((mod) => mod.Tooltip), { ssr: false });
const ResponsiveContainer = dynamic(
  () => import("recharts").then((mod) => mod.ResponsiveContainer),
  { ssr: false }
);

interface DonutChartProps {
  chart: ChartType;
}

export function DonutChart({ chart }: DonutChartProps) {
  if (!chart.series || chart.series.length === 0) {
    return <div className="h-64 flex items-center justify-center text-gray-400">No data available</div>;
  }

  // Transform series into donut data format
  const donutData = (chart.x_labels || []).map((label, idx) => ({
    name: label,
    value: (chart.series?.[0]?.values?.[idx] as number) || 0,
  }));

  const COLORS = ["#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316"];

  return (
    <div className="w-full h-64 rounded-lg border border-gray-200 bg-white p-4">
      <div className="mb-2">
        <h3 className="text-sm font-semibold text-gray-900">{chart.title}</h3>
        {chart.subtitle && <p className="text-xs text-gray-500">{chart.subtitle}</p>}
      </div>
      <ResponsiveContainer width="100%" height="100%">
        <RechartsComposedChart>
          <Pie
            data={donutData}
            cx="50%"
            cy="50%"
            innerRadius={50}
            outerRadius={80}
            paddingAngle={2}
            dataKey="value"
          >
            {donutData.map((_, index) => (
              <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
            ))}
          </Pie>
          <Tooltip formatter={(value) => value.toLocaleString()} />
          <Legend />
        </RechartsComposedChart>
      </ResponsiveContainer>
    </div>
  );
}
