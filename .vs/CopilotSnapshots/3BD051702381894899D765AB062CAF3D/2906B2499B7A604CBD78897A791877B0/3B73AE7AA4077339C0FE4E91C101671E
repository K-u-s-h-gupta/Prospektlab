"use client";

import { RichResponse } from "../lib/types";

interface FilingViewProps {
  data: RichResponse;
}

export function FilingView({ data }: FilingViewProps) {
  return (
    <div className="space-y-6 pb-4">
      {/* Title */}
      {data.title && (
        <div>
          <h2 className="text-2xl font-bold text-gray-900">{data.title}</h2>
          {data.subtitle && <p className="text-gray-600 mt-1">{data.subtitle}</p>}
        </div>
      )}

      {/* Filing Sections */}
      {data.filing_sections && data.filing_sections.length > 0 && (
        <div className="space-y-4">
          {data.filing_sections.map((section, idx) => (
            <div key={idx} className="rounded-lg border border-gray-200 bg-white p-6">
              {section.name && (
                <h3 className="font-semibold text-gray-900 mb-3">{section.name}</h3>
              )}
              <div className="text-sm text-gray-700 whitespace-pre-wrap break-words">
                {section.excerpt || section.text || JSON.stringify(section, null, 2)}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Disclaimer */}
      {data.disclaimer && <div className="text-xs text-gray-500 mt-4 italic">{data.disclaimer}</div>}
    </div>
  );
}
