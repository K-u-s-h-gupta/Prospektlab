IKG_POSTGRES_PASSWORD=change-this-strong-password

# The compose file maps this into worker/scheduler containers.
IKG_DATABASE_URL=postgresql://ikg_user:change-this-strong-password@postgres:5432/ikg
DATABASE_URL=postgresql://ikg_user:change-this-strong-password@postgres:5432/ikg

FINAGENT_GRAPH_SERVING_BACKEND=postgres

QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

FINAGENT_RETRIEVAL_BACKEND=qdrant_postgres
FINAGENT_DISABLE_AZURE_SEARCH=1
FINAGENT_ANNUAL_REPORT_EXTRACT_MODE=metadata_only
FINAGENT_SHP_QUARTERS=40
FINAGENT_BSE_SHP_MAX_QUARTERS=40
