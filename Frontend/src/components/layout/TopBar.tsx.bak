import React from 'react';
import { User, Sparkles, TrendingUp } from 'lucide-react';

interface TopBarProps {
  title: string;
  investorStyle?: string;
  watchlistsCount?: number;
}

export const TopBar: React.FC<TopBarProps> = ({
  title,
  investorStyle = 'Balanced',
  watchlistsCount = 0
}) => {
  return (
    <header style={{
      height: '60px',
      backgroundColor: '#0D0D0D',
      borderBottom: '1px solid #161616',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'space-between',
      padding: '0 24px',
      flexShrink: 0
    }}>
      {/* Title / Section Name */}
      <h2 style={{
        fontSize: '15px',
        fontWeight: 600,
        color: '#F5F5F5',
        display: 'flex',
        alignItems: 'center',
        gap: '8px'
      }}>
        {title === 'Market Dashboard' ? (
          <TrendingUp size={16} color="#E8A838" />
        ) : (
          <Sparkles size={16} color="#E8A838" />
        )}
        {title}
      </h2>

      {/* User Context Info / Style Profile */}
      <div style={{
        display: 'flex',
        alignItems: 'center',
        gap: '16px'
      }}>
        <div style={{
          display: 'flex',
          alignItems: 'center',
          gap: '8px',
          backgroundColor: '#161616',
          border: '1px solid #262626',
          padding: '6px 12px',
          borderRadius: '16px',
          fontSize: '11px',
          color: '#8A8A8A'
        }}>
          <Sparkles size={12} color="#E8A838" />
          <span>Profile: <strong>{investorStyle}</strong></span>
        </div>

        <div style={{
          fontSize: '11px',
          color: '#8A8A8A',
          display: 'block'
        }}>
          Watchlist: <strong>{watchlistsCount} stocks</strong>
        </div>

        {/* Profile Avatar */}
        <div style={{
          width: '32px',
          height: '32px',
          borderRadius: '50%',
          backgroundColor: '#1E1E1E',
          border: '1px solid #262626',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          color: '#E8A838',
          cursor: 'pointer'
        }}
        title="Account details"
        >
          <User size={14} />
        </div>
      </div>
    </header>
  );
};
export default TopBar;
