# Copy to `.env` and fill in. Never commit `.env`.

# TimesFM remote inference endpoint (Azure Container Apps or standalone service)
# When set, finagent will offload TimesFM forecasting to this URL instead of local inference.
# Get the URL after running: .\timesfm-service\deploy-azure.ps1
# TIMESFM_REMOTE_URL=https://timesfm-inference.xxx.eastus.azurecontainerapps.io

OPENAI_API_KEY=
# xAI fallback (used when OPENAI_API_KEY is unavailable)
# XAI_API_KEY=
# FINAGENT_XAI_MODEL=grok-3-mini
# OPENROUTER_API_KEY=
# OPENROUTER_API_NAME=
