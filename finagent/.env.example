# Copy to `.env` and fill in. Never commit `.env`.

OPENAI_API_KEY=
# Azure Communication Services email (preferred over SMTP when configured)
# ACS_EMAIL_CONNECTION_STRING=
# ACS_EMAIL_FROM=auth@notify.prospektlab.com
# Or derive the sender from username + domain instead of ACS_EMAIL_FROM:
# ACS_EMAIL_SENDER_USERNAME=auth
# ACS_EMAIL_DOMAIN=notify.prospektlab.com
# ACS SMS auth (same Communication Service, requires an SMS-capable sender number)
# ACS_SMS_CONNECTION_STRING=
# ACS_SMS_FROM=+15551234567
# AUTH_SMS_DEFAULT_COUNTRY_CODE=+91
# SMTP fallback remains supported for other providers:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# xAI fallback (used when OPENAI_API_KEY is unavailable)
# XAI_API_KEY=
# FINAGENT_XAI_MODEL=grok-3-mini
# OPENROUTER_API_KEY=
# OPENROUTER_API_NAME=

# Supabase app/auth/storage APIs
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Supabase direct database connection for IKG/scrapers.
# Graph backend: "postgres" (production) or "memory" (dev/test).
# Query projection via Memgraph is rebuilt from Postgres (see memgraph_client.py).
IKG_BACKEND=postgres
IKG_DATABASE_URL=
DATABASE_URL=
SUPABASE_DB_URL=

# Tiered memory store (dreaming layer, session memory persistence).
# Point this at Supabase Postgres for cross-session memory.
MEMORY_DATABASE_URL=

# Azure Document Intelligence for SEBI/annual-report PDFs
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# Cost guard: use local PyMuPDF extraction first, then Azure DI only when local
# text/tables are not good enough.
FINAGENT_DI_PROVIDER=local_first
FINAGENT_DI_LOCAL_MIN_CHARS_PER_PAGE=250
FINAGENT_DI_LOCAL_MIN_TOTAL_CHARS=400
FINAGENT_DI_STRICT_ALLOW_LOCAL_ON_AZURE_FAILURE=1
FINAGENT_DI_TRUST_LOCAL_TEXT=0

# IKG pipeline runtime
MCA_COMPANY_MASTER_CSV=data/company_master_data_2026-06-01.csv
FINAGENT_PIPELINE_LOG_DIR=pipeline_logs
FINAGENT_REPORT_CACHE_DIR=data/annual_reports
FINAGENT_GRAPHRAG_CACHE=data/graphrag
# "targeted" extracts high-value sections via XBRL/page-scoring; "metadata_only" stores links only.
FINAGENT_ANNUAL_REPORT_EXTRACT_MODE=targeted
FINAGENT_ANNUAL_REPORT_MAX_SELECTED_PAGES=80
IKG_SCHEDULER_LOCK_TTL_MINUTES=240

# Celery + Redis parallel scraper runtime
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FINAGENT_SCHEDULER_USE_CELERY=0
FINAGENT_SCHEDULER_ENABLE_DREAMING=1
FINAGENT_CELERY_PREFETCH=1

# Default IKG retrieval: Qdrant vectors + Supabase/Postgres full-text.
FINAGENT_RETRIEVAL_BACKEND=qdrant_postgres
FINAGENT_DISABLE_AZURE_SEARCH=1
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ikg_document_sections
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT_S=10

# Azure AI Search hybrid retrieval for IKG document sections (legacy/optional)
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=<your-admin-or-query-key>
AZURE_SEARCH_INDEX=ikg-document-sections
AZURE_SEARCH_SEMANTIC_CONFIG=default
AZURE_SEARCH_VECTOR_FIELD=embedding
