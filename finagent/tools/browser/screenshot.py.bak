"""Screenshot utility backed by Playwright."""

from __future__ import annotations

import logging
from typing import Optional

from finagent.tools.browser.playwright_backend import launch_browser

logger = logging.getLogger("finagent.browser.screenshot")


async def screenshot_page(
    url: str,
    *,
    path: Optional[str] = None,
    full_page: bool = True,
    timeout_ms: int = 30000,
) -> bytes:
    """Capture a screenshot of the given URL and return raw PNG bytes.

    If path is provided, also saves the file to disk.
    """
    async with launch_browser(headless=True) as ctx:
        page = await ctx.new_page()
        try:
            await page.goto(url, wait_until="networkidle", timeout=timeout_ms)
            png_bytes = await page.screenshot(full_page=full_page, path=path)
            logger.info("Screenshot captured for %s (%d bytes)", url, len(png_bytes))
            return png_bytes
        finally:
            await page.close()
