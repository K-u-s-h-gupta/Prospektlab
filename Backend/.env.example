# ORACLE FIOS - Environment Variables

# Tavily API key for web search, news, and research (free: 1000 credits/month)
# Get yours at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Qdrant vector database (local Docker or Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=oracle_documents

# Embedding model (default: all-MiniLM-L6-v2, runs locally, no API needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Future: LLM API keys
# OPENAI_API_KEY=your_openai_key
# GOOGLE_API_KEY=your_google_key
